{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai.capability/v1",
  "title": "AI Framework Capabilities",
  "description": "Allowed capabilities for an AI workflow.",
  "type": "string",
  "enum": [
    "filesystem:none",
    "filesystem:repository",
    "filesystem:explicit_paths",
    "filesystem:user_approved",
    "network:none",
    "network:public",
    "network:allowlist",
    "network:user_approved",
    "process:none",
    "process:test_only",
    "process:project_commands",
    "process:user_approved",
    "browser:none",
    "browser:read_only",
    "browser:project",
    "browser:user_approved",
    "git:read",
    "git:edit",
    "git:commit",
    "git:push",
    "database:none",
    "database:project",
    "database:user_approved",
    "secrets:none",
    "secrets:named_reference"
  ]
}
