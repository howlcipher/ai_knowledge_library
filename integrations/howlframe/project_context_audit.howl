(cli_app
  (let (raw_input (cli_args 0))
    (if (= raw_input "")
      (do
        (print "{\"schema\": \"howlplane.project_context_audit/v1\", \"status\": \"FAIL\", \"findings\": [\"missing input payload\"], \"observed\": {}}")
        (exit 1)
      )
      (try_let (ctx (parse_json Context raw_input))
        (catch err
          (do
            (print "{\"schema\": \"howlplane.project_context_audit/v1\", \"status\": \"FAIL\", \"findings\": [\"malformed json input\"], \"observed\": {}}")
            (exit 1)
          )
        )
        (let (schema_ver (map_get ctx "schema"))
          (let (p_name (map_get ctx "project_name"))
            (let (p_types (map_get ctx "project_types"))
              (let (has_agents (map_get ctx "has_agents_md"))
                (let (has_manifest (map_get ctx "has_manifest"))
                  (let (verif (map_get ctx "verification"))
                    (let (hyg_status (map_get ctx "hygiene_status"))
                      (let (caps (map_get ctx "declared_capabilities"))
                        (let (status "PASS")
                          (let (findings (list))
                            (let (test_c 0)
                              (let (build_c 0)
                                (let (lint_c 0)
                                  (let (hyg_c 0)
                                    (let (total_c 0)
                                      (let (p_types_len 0)
                                        (let (caps_len 0)
                                          (do
                                            (if (is_nil schema_ver)
                                              (do
                                                (set status "FAIL")
                                                (append findings "missing schema version")
                                              )
                                              (if (= schema_ver "")
                                                (do
                                                  (set status "FAIL")
                                                  (append findings "missing schema version")
                                                )
                                                (if (!= schema_ver "howlplane.project_context/v1")
                                                  (do
                                                    (set status "FAIL")
                                                    (append findings "unsupported schema version")
                                                  )
                                                )
                                              )
                                            )
                                            (if (is_nil p_name)
                                              (do
                                                (set status "FAIL")
                                                (append findings "missing project_name")
                                              )
                                              (if (= p_name "")
                                                (do
                                                  (set status "FAIL")
                                                  (append findings "missing project_name")
                                                )
                                              )
                                            )
                                            (if (is_nil p_types)
                                              (do
                                                (set status "FAIL")
                                                (append findings "missing project_types")
                                              )
                                              (if (= p_types "")
                                                (do
                                                  (set status "FAIL")
                                                  (append findings "missing project_types")
                                                )
                                                (do
                                                  (set p_types_len (list_len p_types))
                                                  (if (= p_types_len 0)
                                                    (do
                                                      (if (!= status "FAIL")
                                                        (set status "WARN")
                                                      )
                                                      (append findings "no project types detected")
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                            (if (is_nil has_agents)
                                              (do
                                                (set status "FAIL")
                                                (append findings "missing has_agents_md")
                                              )
                                              (if (= has_agents "")
                                                (do
                                                  (set status "FAIL")
                                                  (append findings "missing has_agents_md")
                                                )
                                                (if has_agents
                                                  (do)
                                                  (do
                                                    (if (!= status "FAIL")
                                                      (set status "WARN")
                                                    )
                                                    (append findings "missing AGENTS.md")
                                                  )
                                                )
                                              )
                                            )
                                            (if (is_nil has_manifest)
                                              (do
                                                (set status "FAIL")
                                                (append findings "missing has_manifest")
                                              )
                                              (if (= has_manifest "")
                                                (do
                                                  (set status "FAIL")
                                                  (append findings "missing has_manifest")
                                                )
                                              )
                                            )
                                            (if (is_nil hyg_status)
                                              (do
                                                (set status "FAIL")
                                                (append findings "missing hygiene_status")
                                              )
                                              (if (= hyg_status "")
                                                (do
                                                  (set status "FAIL")
                                                  (append findings "missing hygiene_status")
                                                )
                                                (if (and (!= hyg_status "configured_and_passed")
                                                         (and (!= hyg_status "not_configured")
                                                              (and (!= hyg_status "configured_tool_missing")
                                                                   (and (!= hyg_status "invalid_configuration")
                                                                        (!= hyg_status "invalid_provider_version")))))
                                                  (do
                                                    (set status "FAIL")
                                                    (append findings "invalid hygiene_status")
                                                  )
                                                )
                                              )
                                            )
                                            (if (is_nil verif)
                                              (do
                                                (set status "FAIL")
                                                (append findings "missing verification section")
                                              )
                                              (if (= verif "")
                                                (do
                                                  (set status "FAIL")
                                                  (append findings "missing verification section")
                                                )
                                                (do
                                                  (let (tc (map_get verif "test_count"))
                                                    (if (is_nil tc)
                                                      (do
                                                        (set status "FAIL")
                                                        (append findings "missing test_count")
                                                      )
                                                      (if (= tc "")
                                                        (do
                                                          (set status "FAIL")
                                                          (append findings "missing test_count")
                                                        )
                                                        (do
                                                          (set test_c (to_int tc))
                                                          (if (< test_c 0)
                                                            (do
                                                              (set status "FAIL")
                                                              (append findings "negative test_count")
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                  (let (bc (map_get verif "build_count"))
                                                    (if (is_nil bc)
                                                      (do
                                                        (set status "FAIL")
                                                        (append findings "missing build_count")
                                                      )
                                                      (if (= bc "")
                                                        (do
                                                          (set status "FAIL")
                                                          (append findings "missing build_count")
                                                        )
                                                        (do
                                                          (set build_c (to_int bc))
                                                          (if (< build_c 0)
                                                            (do
                                                              (set status "FAIL")
                                                              (append findings "negative build_count")
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                  (let (lc (map_get verif "lint_count"))
                                                    (if (is_nil lc)
                                                      (do
                                                        (set status "FAIL")
                                                        (append findings "missing lint_count")
                                                      )
                                                      (if (= lc "")
                                                        (do
                                                          (set status "FAIL")
                                                          (append findings "missing lint_count")
                                                        )
                                                        (do
                                                          (set lint_c (to_int lc))
                                                          (if (< lint_c 0)
                                                            (do
                                                              (set status "FAIL")
                                                              (append findings "negative lint_count")
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                  (let (hc (map_get verif "hygiene_count"))
                                                    (if (is_nil hc)
                                                      (do
                                                        (set status "FAIL")
                                                        (append findings "missing hygiene_count")
                                                      )
                                                      (if (= hc "")
                                                        (do
                                                          (set status "FAIL")
                                                          (append findings "missing hygiene_count")
                                                        )
                                                        (do
                                                          (set hyg_c (to_int hc))
                                                          (if (< hyg_c 0)
                                                            (do
                                                              (set status "FAIL")
                                                              (append findings "negative hygiene_count")
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                  (set total_c (+ test_c (+ build_c (+ lint_c hyg_c))))
                                                  (if (= total_c 0)
                                                    (do
                                                      (if (!= status "FAIL")
                                                        (set status "WARN")
                                                      )
                                                      (append findings "no verification commands configured")
                                                    )
                                                  )
                                                  (if (and (> hyg_c 0) (= hyg_status "not_configured"))
                                                    (do
                                                      (if (!= status "FAIL")
                                                        (set status "WARN")
                                                      )
                                                      (append findings "hygiene commands discovered but hygiene_status is not_configured")
                                                    )
                                                  )
                                                  (if (and (= hyg_c 0) (= hyg_status "configured_and_passed"))
                                                    (do
                                                      (if (!= status "FAIL")
                                                        (set status "WARN")
                                                      )
                                                      (append findings "hygiene status is configured_and_passed but zero hygiene commands configured")
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                            (if (is_nil caps)
                                              (set caps_len 0)
                                              (if (= caps "")
                                                (set caps_len 0)
                                                (set caps_len (list_len caps))
                                              )
                                            )
                                            (let (findings_json (list))
                                              (do
                                                (for f findings
                                                  (append findings_json (str_join (list "\"" (to_string f) "\"") ""))
                                                )
                                                (let (findings_str (str_join findings_json ", "))
                                                  (let (types_json (list))
                                                    (do
                                                      (if (is_nil p_types)
                                                        (do)
                                                        (if (= p_types "")
                                                          (do)
                                                          (for pt p_types
                                                            (append types_json (str_join (list "\"" (to_string pt) "\"") ""))
                                                          )
                                                        )
                                                      )
                                                      (let (types_str (str_join types_json ", "))
                                                        (let (has_agents_str "false")
                                                          (let (has_manifest_str "false")
                                                            (do
                                                              (if (is_nil has_agents)
                                                                (do)
                                                                (if (= has_agents "")
                                                                  (do)
                                                                  (if has_agents (set has_agents_str "true"))
                                                                )
                                                              )
                                                              (if (is_nil has_manifest)
                                                                (do)
                                                                (if (= has_manifest "")
                                                                  (do)
                                                                  (if has_manifest (set has_manifest_str "true"))
                                                                )
                                                              )
                                                              (print (str_join (list
                                                                "{"
                                                                "\"schema\": \"howlplane.project_context_audit/v1\", "
                                                                "\"status\": \"" status "\", "
                                                                "\"findings\": [" findings_str "], "
                                                                "\"observed\": {"
                                                                "\"project_name\": \"" (to_string p_name) "\", "
                                                                "\"project_types\": [" types_str "], "
                                                                "\"has_agents_md\": " has_agents_str ", "
                                                                "\"has_manifest\": " has_manifest_str ", "
                                                                "\"verification_surfaces\": " (to_string total_c) ", "
                                                                "\"hygiene_status\": \"" (to_string hyg_status) "\", "
                                                                "\"capabilities_count\": " (to_string caps_len)
                                                                "}}"
                                                              ) ""))
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
